    "version": "0.2.0",
    "configurations": [
        {
            "name": "(ctest) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${cmake.testProgram}",
            "args": [
                "${cmake.testArgs}"
            ],
            "stopAtEntry": false,
            "cwd": "${cmake.testWorkingDirectory}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb"
        }
    ]
}
